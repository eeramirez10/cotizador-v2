# Copy to .env.staging. Vite embeds these public URLs in the browser bundle.
VITE_CORE_API_URL=https://STAGING_PUBLIC_HOST/cotizador-staging
VITE_AI_API_URL=https://STAGING_PUBLIC_HOST/ia-staging

# Leave ERP integrations empty until a read-only test endpoint is agreed.
VITE_ERP_API_URL=
VITE_ERP_USERS_API_URL=https://STAGING_PUBLIC_HOST/erp-users-unavailable
VITE_USER_EMAIL_DOMAIN=tuvansa.com.mx

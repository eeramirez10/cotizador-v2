# Copy to .env.staging. Vite embeds these public URLs in the browser bundle.
VITE_CORE_API_URL=https://STAGING_PUBLIC_HOST/cotizador-staging
# Browser AI requests use the JWT-protected core proxy, never the internal AI API.
VITE_AI_API_URL=https://STAGING_PUBLIC_HOST/cotizador-staging

# Authenticated staging core bridge; the ERP internal key stays server-side.
VITE_ERP_API_URL=https://STAGING_PUBLIC_HOST/cotizador-staging/api/staging/erp
VITE_ERP_PRODUCTS_BASE_PATH=/products
VITE_ERP_CUSTOMERS_BASE_PATH=/customers
VITE_ERP_USERS_API_URL=https://STAGING_PUBLIC_HOST/cotizador-staging/api/staging/erp
VITE_ERP_USERS_BASE_PATH=/users
VITE_USER_EMAIL_DOMAIN=tuvansa.com.mx
